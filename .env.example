DATABASE_URL=
SESSION_SECRET=
# Optional bootstrap only — copied into DB Setting once. Prefer /admin/forgot-password OTP.
# Escape $ as \$ in some panels; the app also normalizes literal \$ automatically.
ADMIN_PASSWORD_HASH=
# Required on Vercel for durable media. Create a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
# Local/Hostinger disk fallback only (absolute path in production without Blob).
UPLOAD_DIR=
RESEND_API_KEY=
# Until your domain is verified in Resend, use the onboarding address (account email only):
EMAIL_FROM=Lagom Design <onboarding@resend.dev>
# After verifying studiolagomdesign.com in Resend:
# EMAIL_FROM=Lagom Design <noreply@studiolagomdesign.com>