{
  "name": "lagom-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "build:cta-collage": "tsx scripts/build-cta-collage.ts",
    "test:auth-e2e": "tsx --env-file=.env scripts/test-auth-e2e.ts",
    "test:auth-e2e:prod": "TEST_EXPECT_PRODUCTION=1 tsx --env-file=.env scripts/test-auth-e2e.ts",
    "test:auth-e2e:deployed": "./scripts/test-auth-e2e-deployed.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "iron-session": "^8.0.4",
    "next": "16.2.9",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
